{
  "name": "dsh-trellis",
  "version": "0.1.8",
  "description": "Trellis workflow integration for DeepSeek Harness: per-turn workflow-state breadcrumbs, utility commands, and native session identity.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "author": "SajoLuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SajoLuo/dsh-trellis.git"
  },
  "homepage": "https://github.com/SajoLuo/dsh-trellis#readme",
  "bugs": {
    "url": "https://github.com/SajoLuo/dsh-trellis/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "trellis",
    "workflow",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build:client": "tsdown",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "pnpm run build:client",
    "test:compat": "node scripts/test-compat.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell-env": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.7-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.7-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.1",
    "@deepseek-ai/dsh-util-time": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "^0.22.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.1"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-rc.1"
  }
}
